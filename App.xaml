<Application x:Class="HyperSwitch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="AccentColor">#0B6DEB</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#16181C" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#596579" />
            <SolidColorBrush x:Key="PanelBrush" Color="#F5F8FC" />
            <SolidColorBrush x:Key="LineBrush" Color="#D9E0E9" />

            <LinearGradientBrush x:Key="RockerFaceInactiveBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#F4F6FA" Offset="0.48" />
                <GradientStop Color="#DCE1E9" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="RockerFaceActiveBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#24A2FF" Offset="0" />
                <GradientStop Color="#0879F4" Offset="0.45" />
                <GradientStop Color="#0058CF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="RockerDepthInactiveBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#AEB7C4" Offset="0" />
                <GradientStop Color="#667181" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="RockerDepthActiveBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#064BBA" Offset="0" />
                <GradientStop Color="#012969" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="ModeOptionStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="{StaticResource RockerFaceInactiveBrush}" />
                <Setter Property="BorderBrush" Value="#E8ECF2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Margin="3,2,3,3">
                                <Border x:Name="KeyDepth"
                                        Margin="0,14,0,0"
                                        Background="{StaticResource RockerDepthInactiveBrush}"
                                        BorderBrush="#596474"
                                        BorderThickness="1"
                                        CornerRadius="24" />
                                <Border x:Name="KeyFace"
                                        Margin="0,0,0,13"
                                        Padding="18"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="24"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="6" />
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#25364C"
                                                          BlurRadius="8"
                                                          Direction="270"
                                                          ShadowDepth="3"
                                                          Opacity="0.24" />
                                    </Border.Effect>
                                    <Grid>
                                        <Border x:Name="Gloss"
                                                Height="58"
                                                Margin="1"
                                                VerticalAlignment="Top"
                                                CornerRadius="21,21,9,9"
                                                IsHitTestVisible="False"
                                                Opacity="0.7">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#AFFFFFFF" Offset="0" />
                                                    <GradientStop Color="#28FFFFFF" Offset="0.7" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="KeyFace" Property="Background" Value="{StaticResource RockerFaceActiveBrush}" />
                                    <Setter TargetName="KeyFace" Property="BorderBrush" Value="#6FC9FF" />
                                    <Setter TargetName="KeyDepth" Property="Background" Value="{StaticResource RockerDepthActiveBrush}" />
                                    <Setter TargetName="KeyDepth" Property="BorderBrush" Value="#061C45" />
                                    <Setter TargetName="KeyFace" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-2" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Gloss" Property="Opacity" Value="0.95" />
                                    <Setter TargetName="KeyFace" Property="BorderBrush" Value="#72C5FF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="KeyFace" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="7" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="KeyFace" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="22,11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#075FCF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#064EAA" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
