<Window x:Class="HyperSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HyperSwitch.Localization"
        Title="{x:Static loc:Strings.AppTitle}"
        Width="840"
        Height="610"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#FAFCFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="44,34,44,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{x:Static loc:Strings.Heading}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       HorizontalAlignment="Center" />

            <Grid Grid.Row="1" Margin="35,18,35,0" Height="220">
                <Image x:Name="RockerImage"
                       Source="/Assets/rocker-wsl.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False" />
                <Grid Margin="34,24,34,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="WslModeOption"
                                 Grid.Column="0"
                                 GroupName="HypervisorMode"
                                 Style="{StaticResource RockerHitAreaStyle}"
                                 Checked="ModeOption_Checked"
                                 AutomationProperties.Name="{x:Static loc:Strings.WslAutomationName}" />
                    <RadioButton x:Name="VmModeOption"
                                 Grid.Column="1"
                                 GroupName="HypervisorMode"
                                 Style="{StaticResource RockerHitAreaStyle}"
                                 Checked="ModeOption_Checked"
                                 AutomationProperties.Name="{x:Static loc:Strings.VmAutomationName}" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="65,22,65,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static loc:Strings.ModeWsl}" FontSize="25" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static loc:Strings.WslDescription}" Margin="0,5,0,0" FontSize="15"
                               Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <Border x:Name="WslActiveBadge" Margin="0,12,0,0" Padding="12,5" CornerRadius="16"
                            Background="#D8ECFF" Visibility="Collapsed" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static loc:Strings.ActiveNow}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static loc:Strings.ModeVm}" FontSize="25" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static loc:Strings.VmDescription}" Margin="0,5,0,0" FontSize="15"
                               Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <Border x:Name="VmActiveBadge" Margin="0,12,0,0" Padding="12,5" CornerRadius="16"
                            Background="#D8ECFF" Visibility="Collapsed" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static loc:Strings.ActiveNow}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0">
                <TextBlock Text="ⓘ" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,9,0" />
                <TextBlock x:Name="StatusText"
                           Text="{x:Static loc:Strings.StatusRestartRequired}"
                           FontSize="14"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#F4F7FB" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0">
                <Button x:Name="ApplyButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyButton_Click"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="19" Margin="0,-2,10,0" />
                        <TextBlock Text="{x:Static loc:Strings.Apply}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{x:Static loc:Strings.Cancel}" Margin="14,0,0,0" Padding="22,11" FontSize="15"
                        IsCancel="True" Click="CancelButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
